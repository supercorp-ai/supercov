{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssertionMap",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 1,
      "default": 1
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Assertion"
      }
    },
    "retiredAssertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Retired"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "assertions"
  ],
  "$defs": {
    "Assertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Anchor"
        },
        "analysis": {
          "$ref": "#/$defs/Analysis",
          "default": "unmapped"
        },
        "observes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Flow"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "at"
      ]
    },
    "Anchor": {
      "description": "One-based lines and UTF-8 byte columns, for every language. Text is exact.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column",
        "text"
      ]
    },
    "Analysis": {
      "type": "string",
      "enum": [
        "unmapped",
        "partial",
        "mapped"
      ]
    },
    "Flow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "appliesTo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "default": []
        },
        "countsAsAsserted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "watch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Watch"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "explanation",
        "nodes",
        "countsAsAsserted",
        "watch"
      ]
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Anchor"
        },
        "role": {
          "type": "string"
        },
        "meaning": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "at"
      ]
    },
    "Edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ]
    },
    "Watch": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "file"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "file"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "$ref": "#/$defs/Anchor"
            },
            "kind": {
              "type": "string",
              "const": "span"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "at"
          ]
        }
      ]
    },
    "Retired": {
      "type": "object",
      "properties": {
        "assertion": {
          "$ref": "#/$defs/Assertion"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "assertion",
        "reason"
      ]
    }
  }
}
