{
  "description": "Public projects for validating `supercov mutants test` under the JavaScript runners other than Vitest and Playwright against StrykerJS 10.1.1. Read by run.mjs.",
  "stryker": "10.1.1",
  "projects": [
    {
      "name": "bytes",
      "runner": "mocha",
      "repo": "https://github.com/visionmedia/bytes.js",
      "commit": "9ddc13b6c66e0cb293616fba246e05db4b6cef4d",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npx",
        "mocha",
        "--check-leaks",
        "--reporter",
        "spec"
      ],
      "sources": "index.js",
      "mutate": [
        "index.js"
      ],
      "stryker": {
        "testRunner": "mocha",
        "mochaOptions": {
          "spec": [
            "test/**/*.js"
          ]
        },
        "coverageAnalysis": "perTest"
      }
    },
    {
      "name": "negotiator",
      "runner": "mocha",
      "repo": "https://github.com/jshttp/negotiator",
      "commit": "14b0a7b88e7e7bb1cae38681195951bff29ca2fd",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npx",
        "mocha",
        "--reporter",
        "spec",
        "--check-leaks",
        "test/"
      ],
      "sources": "lib,index.js",
      "mutate": [
        "lib/**/*.js",
        "index.js"
      ],
      "stryker": {
        "testRunner": "mocha",
        "mochaOptions": {
          "spec": [
            "test/**/*.js"
          ]
        },
        "coverageAnalysis": "perTest"
      }
    },
    {
      "name": "ms",
      "runner": "jest",
      "repo": "https://github.com/vercel/ms",
      "commit": "4ff48cec099f0514c3e9bbca18706c9c21122bfb",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund",
        "--ignore-scripts"
      ],
      "test": [
        "npx",
        "jest",
        "--env",
        "node"
      ],
      "sources": "src/index.ts",
      "mutate": [
        "src/index.ts"
      ],
      "stryker": {
        "testRunner": "jest",
        "jest": {
          "config": {
            "testEnvironment": "node"
          }
        },
        "coverageAnalysis": "perTest"
      },
      "note": "Installed with npm: StrykerJS's Jest runner needs jest-environment-node where pnpm's layout does not hoist it"
    },
    {
      "name": "cron-parser",
      "runner": "jest",
      "repo": "https://github.com/harrisiirak/cron-parser",
      "commit": "286b871d68040e4afa37d426a4e72dc42ec62256",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund",
        "--ignore-scripts"
      ],
      "env": {
        "TZ": "UTC"
      },
      "test": [
        "npx",
        "jest"
      ],
      "sources": "src/CronExpressionParser.ts",
      "mutate": [
        "src/CronExpressionParser.ts"
      ],
      "stryker": {
        "testRunner": "jest",
        "coverageAnalysis": "perTest"
      }
    },
    {
      "name": "classnames",
      "runner": "node:test",
      "repo": "https://github.com/JedWatson/classnames",
      "commit": "abd6314010de053a09df5acc53e474ff65cea470",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "node",
        "--test",
        "tests/*.js"
      ],
      "sources": "index.js,bind.js,dedupe.js",
      "mutate": [
        "index.js",
        "bind.js",
        "dedupe.js"
      ],
      "stryker": {
        "testRunner": "command",
        "commandRunner": {
          "command": "node --test tests/*.js"
        },
        "coverageAnalysis": "off"
      }
    },
    {
      "name": "camelcase",
      "runner": "node:test",
      "repo": "https://github.com/sindresorhus/camelcase",
      "commit": "328428291b2f5c0e41dd4a2d0e5a942eb9de3b70",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "node",
        "--test"
      ],
      "sources": "index.js",
      "mutate": [
        "index.js"
      ],
      "stryker": {
        "testRunner": "command",
        "commandRunner": {
          "command": "node --test"
        },
        "coverageAnalysis": "off"
      }
    },
    {
      "name": "dot-prop",
      "runner": "ava",
      "repo": "https://github.com/sindresorhus/dot-prop",
      "commit": "d5d11c71a70bfb643a45d22821ed6d284240fce5",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npx",
        "ava"
      ],
      "sources": "index.js",
      "mutate": [
        "index.js"
      ],
      "stryker": {
        "testRunner": "command",
        "commandRunner": {
          "command": "npx ava"
        },
        "coverageAnalysis": "off"
      }
    },
    {
      "name": "p-map",
      "runner": "ava",
      "repo": "https://github.com/sindresorhus/p-map",
      "commit": "d61b6a33cc1d5533ad5711b435959f3f78c3d2fe",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npx",
        "ava"
      ],
      "sources": "index.js",
      "mutate": [
        "index.js"
      ],
      "stryker": {
        "testRunner": "command",
        "commandRunner": {
          "command": "npx ava"
        },
        "coverageAnalysis": "off",
        "timeoutMS": 10000
      }
    },
    {
      "name": "ini",
      "runner": "tap",
      "repo": "https://github.com/npm/ini",
      "commit": "3c96c74fd42584bd655e17a4e63e2ef0a3b406ee",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npx",
        "tap"
      ],
      "sources": "lib",
      "mutate": [
        "lib/**/*.js"
      ],
      "stryker": {
        "testRunner": "tap",
        "coverageAnalysis": "perTest"
      }
    },
    {
      "name": "remix-auth",
      "runner": "bun:test",
      "repo": "https://github.com/sergiodxa/remix-auth",
      "commit": "572811928b5501eea1754b53260b21a8435c185f",
      "install": [
        "bun",
        "install",
        "--frozen-lockfile"
      ],
      "test": [
        "bun",
        "test"
      ],
      "sources": "src",
      "mutate": [
        "src/**/*.ts",
        "!src/**/*.test.ts"
      ],
      "stryker": {
        "testRunner": "command",
        "commandRunner": {
          "command": "bun test"
        },
        "coverageAnalysis": "off"
      }
    },
    {
      "name": "mini-throttle",
      "runner": "vitest-browser",
      "repo": "https://github.com/github/mini-throttle",
      "commit": "b37bfbf676c7ffa90c1714d1184c958d77d0e653",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "browsers": true,
      "test": [
        "npx",
        "vitest",
        "run"
      ],
      "sources": "index.ts,decorators.ts",
      "mutate": [
        "index.ts",
        "decorators.ts"
      ],
      "stryker": {
        "testRunner": "vitest",
        "coverageAnalysis": "perTest"
      },
      "note": "StrykerJS's command runner switches a mutant on through the environment, which the browser never reads: every mutant survives under it. Its Vitest runner switches it on in the page."
    },
    {
      "name": "deep-eql",
      "runner": "mocha",
      "repo": "https://github.com/chaijs/deep-eql",
      "commit": "c6791c2967fda91822f37a73fd2448e817e14711",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npx",
        "mocha"
      ],
      "sources": "index.js",
      "mutate": [
        "index.js"
      ],
      "stryker": {
        "testRunner": "mocha",
        "mochaOptions": {
          "spec": [
            "test/**/*.js"
          ]
        },
        "coverageAnalysis": "perTest"
      }
    },
    {
      "name": "pathval",
      "runner": "mocha",
      "repo": "https://github.com/chaijs/pathval",
      "commit": "820590ed322d9deca69c0c1c2827d57d2e6daaff",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "test": [
        "npx",
        "mocha"
      ],
      "sources": "index.js",
      "mutate": [
        "index.js"
      ],
      "stryker": {
        "testRunner": "mocha",
        "mochaOptions": {
          "spec": [
            "test/**/*.js"
          ]
        },
        "coverageAnalysis": "perTest"
      }
    },
    {
      "name": "uuid",
      "runner": "jest",
      "repo": "https://github.com/uuidjs/uuid",
      "commit": "v9.0.1",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund",
        "--ignore-scripts"
      ],
      "env": {
        "BABEL_ENV": "commonjsNode"
      },
      "test": [
        "npx",
        "jest",
        "test/unit/"
      ],
      "sources": "src",
      "mutate": [
        "src/**/*.js"
      ],
      "stryker": {
        "testRunner": "jest",
        "jest": {
          "config": {
            "testEnvironment": "node",
            "roots": [
              "<rootDir>/test/unit"
            ]
          }
        },
        "coverageAnalysis": "perTest",
        "ignorePatterns": [
          ".supercov",
          ".local"
        ]
      },
      "note": "Jest 28: its configuration is read through jest-config's own build (no readInitialOptions before 29.3)"
    },
    {
      "name": "luxon-duration",
      "runner": "jest",
      "repo": "https://github.com/moment/luxon",
      "commit": "3.4.4",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund",
        "--ignore-scripts"
      ],
      "env": {
        "TZ": "America/New_York"
      },
      "test": [
        "npx",
        "jest",
        "--testPathIgnorePatterns",
        "test/(datetime/(create|format|localeWeek|set|tokenParse)|info/localeWeek|interval/format)\\.test\\.js"
      ],
      "sources": "src/duration.js",
      "mutate": [
        "src/duration.js"
      ],
      "stryker": {
        "testRunner": "jest",
        "jest": {
          "config": {
            "testPathIgnorePatterns": [
              "/node_modules/",
              "test/(datetime/(create|format|localeWeek|set|tokenParse)|info/localeWeek|interval/format)\\.test\\.js"
            ]
          }
        },
        "coverageAnalysis": "perTest"
      },
      "note": "Jest 29, 1,094 tests; one file's mutants, as the whole of luxon is over a job's ten minutes for StrykerJS. Seven test files whose locale week and calendar tests fail on Node 24's ICU without any mutant are left out"
    },
    {
      "name": "yup",
      "runner": "jest",
      "repo": "https://github.com/jquense/yup",
      "commit": "v1.4.0",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund",
        "--ignore-scripts"
      ],
      "test": [
        "npx",
        "jest"
      ],
      "sources": "src",
      "mutate": [
        "src/**/*.ts"
      ],
      "stryker": {
        "testRunner": "jest",
        "coverageAnalysis": "perTest",
        "jest": {
          "config": {
            "globals": {
              "YUP_USE_SYNC": false
            },
            "testEnvironment": "node",
            "setupFilesAfterEnv": [
              "<rootDir>/test-setup.js"
            ],
            "roots": [
              "<rootDir>/test"
            ],
            "testRegex": "\\.(j|t)s$",
            "testPathIgnorePatterns": [
              "helpers\\.ts",
              "\\.eslintrc\\.js",
              "types\\.ts"
            ]
          }
        }
      },
      "note": "Jest 27: its configuration (roots, testRegex) is in package.json, which StrykerJS's Jest runner does not read from Jest 27, so it is given to StrykerJS as written there"
    }
  ]
}
