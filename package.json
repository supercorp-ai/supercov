{
  "name": "supercov",
  "version": "0.0.2",
  "description": "Zero-edit, runner-aware coverage completeness for JavaScript test suites",
  "repository": {
    "type": "git",
    "url": "https://github.com/supercorp-ai/supercov.git"
  },
  "homepage": "https://github.com/supercorp-ai/supercov#readme",
  "bugs": {
    "url": "https://github.com/supercorp-ai/supercov/issues"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "supercov": "bin/supercov.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./playwright": "./dist/playwright.js",
    "./register": "./dist/register.mjs",
    "./vite": "./dist/vitePlugin.js",
    "./vitest": "./dist/vitest.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run tests/unit",
    "test:types": "tsc --noEmit",
    "test:fixture": "npm run build && npm --prefix tests/fixtures/generic-playwright run test:coverage",
    "check": "npm run test && npm run test:types",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "vite": ">=5.0.0",
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
