#!/usr/bin/env ruby
# frozen_string_literal: true

# One gem is built per platform and carries exactly one executable; on Windows
# it is named with the extension the platform requires.
candidates = ["supercov", "supercov.exe"].map do |name|
  File.expand_path("../libexec/#{name}", __dir__)
end
binary = candidates.find { |path| File.file?(path) && File.executable?(path) }

unless binary
  warn "supercov: packaged Rust executable is missing or not executable: #{candidates.join(", ")}"
  exit 126
end

# The program as a [path, argv0] pair: Ruby never hands that to a shell. A
# lone string -- the path, when no arguments follow -- went through /bin/sh
# when it held a space or a parenthesis, and `supercov` alone failed in a gem
# directory with one.
exec([binary, binary], *ARGV)
