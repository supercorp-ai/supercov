{
  "modelVersion": 1,
  "status": "frozen-private-frontend",
  "language": "rust",
  "variant": "rust-source-v1",
  "decisionSemantics": "masking-mcdc",
  "conditionOrder": "source-evaluation-order",
  "probeModel": "ternary-decision-v2",
  "genericAggregation": "authored-source-obligation",
  "sourceIdentity": {
    "version": 1,
    "digest": "sha256",
    "idDigestBytes": 12,
    "separator": "nul",
    "authoredCanonicalFields": ["model", "obligation-kind", "source-key", "start-byte", "end-byte", "semantic-discriminator"],
    "syntheticExpansionCanonicalFields": ["model", "obligation-kind", "callsite-source-key", "start-byte", "end-byte", "semantic-discriminator", "expansion-chain", "stable-owner-path", "owner-local-ordinal"],
    "generatedSourceKeyFields": ["project-relative-package-root", "out-relative-path"],
    "repeatedAuthoredExpansionsAggregate": true,
    "distinctSyntheticInvocationsRemainDistinct": true,
    "ephemeralPathsForbidden": true,
    "collisionPolicy": "fatal"
  },
  "pointKinds": ["statement", "function"],
  "controlDecisionKinds": [
    "if",
    "if-let",
    "while",
    "while-let",
    "let-chain",
    "match-guard",
    "assertion"
  ],
  "branchKinds": [
    "decision-outcome",
    "logical-selection",
    "loop-entry",
    "match-arm",
    "let-else",
    "try-operator",
    "assertion-outcome"
  ],
  "requiredOwnedSurfaces": [
    "authored-source",
    "declarative-macro-expansion",
    "procedural-macro-expansion",
    "derive-expansion",
    "build-script-generated-source",
    "included-source",
    "const-evaluation",
    "doctest-source"
  ],
  "requiredIdentityAxes": ["run", "worker", "test", "retry", "phase"],
  "completenessRequires": [
    "all-obligations-observed",
    "masking-mcdc-witness-per-condition",
    "zero-blocking-limitations",
    "zero-corrupt-recognized-evidence",
    "exact-required-identity"
  ],
  "externalCoverageInProduct": false
}
